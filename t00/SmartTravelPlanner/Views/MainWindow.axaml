<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SmartTravelPlanner.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:SmartTravelPlanner.Views"
        mc:Ignorable="d" d:DesignWidth="615" d:DesignHeight="300"
        x:Class="SmartTravelPlanner.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/app.ico"
        Title="{Binding TravelerFile, StringFormat='Smart Travel Planner ({0})', 
                                TargetNullValue='Smart Travel Planner (New Traveler)'}"
        Width="600"
        SizeToContent="WidthAndHeight"
        CanResize="False">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,Smart Travel Planer {Binding }
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
                <MenuItem Header="&#x1F464; Traveler">
                        <MenuItem Header="Save"
                                Command="{Binding SaveTravelerCommand}"
                                IsEnabled="{Binding IsSaveTravelerMenuItemEnabled}">
                                <MenuItem.Icon>
                                        <TextBlock Text="&#x1F4BE;"
                                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Load"
                                Command="{Binding LoadTravelerCommand}">
                                <MenuItem.Icon>
                                        <TextBlock Text="&#x1F4C2;"
                                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </MenuItem.Icon>
                        </MenuItem>
                </MenuItem>
                <MenuItem Header="{Binding ThemeIcon}"
                        Command="{Binding ToggleThemeCommand}" />
        </Menu>

        <StackPanel Orientation="Horizontal"
                DockPanel.Dock="Bottom" 
                Spacing="8"
                HorizontalAlignment="Center" Margin="15">
                <Button Content="Creating traveler"
                        IsEnabled="{Binding IsNameView}" />
                <TextBlock Text="->"
                           VerticalAlignment="Center" />
                <Button Content="Loading map"
                        IsEnabled="{Binding IsMapView}"/>
                <TextBlock Text="->"
                           VerticalAlignment="Center" />
                <Button Content="Setting up point A&amp;b"
                        IsEnabled="{Binding IsInputView}" />
                <TextBlock Text="->"
                           VerticalAlignment="Center" />
                <Button Content="Getting route"
                        IsEnabled="{Binding IsOutputView}" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom"
                HorizontalAlignment="Center" Margin="0,7,0,0">
                <TextBlock Text="{Binding FormattedSavedData}"
                        Foreground="Gray"
                        TextAlignment="Center"
                        LineSpacing="7" />
        </StackPanel>

        <Carousel SelectedIndex="{Binding CurrentPageIndex}"
                Margin="12">
                <views:NameView />
                <views:MapView />
                <views:InputView />
                <views:OutputView />
        </Carousel>
    </DockPanel>
    

</Window>
