<ContentPage xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SmartTravelPlanner.ViewModels"
        x:Class="SmartTravelPlanner.Views.NameView"
        x:DataType="vm:MainViewModel">

    <StackPanel Spacing="20">
        <StackPanel Spacing="8">
            <StackPanel Spacing="4"
                HorizontalAlignment="Center">
                <TextBlock Text="Traveler's name"
                    Name="nameLabel"
                    HorizontalAlignment="Left" />
                <TextBox PlaceholderText="Jonh Leng" Text="{Binding TravelerFile}"
                    Width="200" HorizontalAlignment="Center" />
            </StackPanel>
            <StackPanel Spacing="4"
            HorizontalAlignment="Center">
                <TextBlock Text="Current location"
                        HorizontalAlignment="Left" />
                <AutoCompleteBox PlaceholderText="Izum" Text="{Binding StartLocation, UpdateSourceTrigger=PropertyChanged}"
                        ItemsSource="{Binding CitiesCollection}"
                        Width="200" />
            </StackPanel>
        </StackPanel>
        <Button Content="Create Traveler -&gt;"
            Command="{Binding GoToMapViewCommand}"
            IsDefault="True"
            HorizontalAlignment="Center" />
    </StackPanel>
    
</ContentPage>
